# Email Configuration (To send actual emails to your inbox)
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Google Gemini AI — Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here